          type: string
          maxLength: 2048
          pattern: >-
            ^(https?:)?//(?:(?:[a-z0-9\u00a1-\uffff][a-z0-9\u00a1-\uffff_-]{0,62})?[a-z0-9\u00a1-\uffff]\.)+[a-z\u00a1-\uffff]{2,}\.?(?:[/?#]\S*)?$
          format: uri
          title: Linkedin Profile
        business_logo:
          type: string
          title: Business Logo
        locations_distribution:
          items:
            type: object
          type: array
          title: Locations Distribution
      type: object
      required:
        - business_id
      title: FirmographicsOutputSchema
    NumberOfEmployeesRange:
      type: string
      enum:
        - 1-10
        - 11-50
        - 51-200
        - 201-500
        - 501-1000
        - 1001-5000
        - 5001-10000
        - 10001+
      title: NumberOfEmployeesRange
      description: >-
        The `NumberOfEmployeesRange` class is an enumeration that represents
        predefined ranges

        for the number of employees in a company. These ranges are used for
        filtering and

        categorizing companies based on their workforce size.
    RevenueRange:
      type: string
      enum:
        - 0-500K
        - 500K-1M
        - 1M-5M
        - 5M-10M
        - 10M-25M
        - 25M-75M
        - 75M-200M
        - 200M-500M
        - 500M-1B
        - 1B-10B
        - 10B-100B
        - 100B-1T
        - 1T-10T
        - 10T+
      title: RevenueRange
      description: >-
        The `RevenueRange` class is an enumeration that represents predefined
        ranges for the revenue of a company.
  securitySchemes:
    APIKeyHeader:
      type: apiKey
      in: header
      name: api_key

