          title: Data
        entity_id:
          anyOf:
            - type: string
              pattern: ^[a-f0-9]{32}$
            - type: string
              pattern: ^[a-f0-9]{40}$
          title: Entity Id
      type: object
      required:
        - response_context
      title: ProspectsEnrichResponse[ProfilesOutputSchema]
      description: 'This is base response model for all responses in partner service. '
    HTTPValidationError:
