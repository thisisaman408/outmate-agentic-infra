          maxLength: 2048
          pattern: >-
            ^(https?:)?//(?:(?:[a-z0-9\u00a1-\uffff][a-z0-9\u00a1-\uffff_-]{0,62})?[a-z0-9\u00a1-\uffff]\.)+[a-z\u00a1-\uffff]{2,}\.?(?:[/?#]\S*)?$
          format: uri
          title: Link To Html
        link_to_filing_details:
          type: string
          maxLength: 2048
          pattern: >-
            ^(https?:)?//(?:(?:[a-z0-9\u00a1-\uffff][a-z0-9\u00a1-\uffff_-]{0,62})?[a-z0-9\u00a1-\uffff]\.)+[a-z\u00a1-\uffff]{2,}\.?(?:[/?#]\S*)?$
          format: uri
          title: Link To Filing Details
        form_type:
          type: string
          title: Form Type
        accession_number:
          type: string
          title: Accession Number
        company_data_security_breach:
          items:
            type: string
          type: array
          title: Company Data Security Breach
        company_market_saturation:
          items:
            type: string
          type: array
          title: Company Market Saturation
        form_description:
          type: string
          title: Form Description
        company_name:
          type: string
          maxLength: 256
          title: Company Name
        cik:
          type: string
          title: Cik
        filed_at:
          type: string
          format: date-time
          title: Filed At
        company_data_security_privacy:
          items:
            type: string
          type: array
          title: Company Data Security Privacy
        company_competition:
          items:
            type: string
          type: array
          title: Company Competition
        company_customer_adoption:
          items:
            type: string
          type: array
          title: Company Customer Adoption
