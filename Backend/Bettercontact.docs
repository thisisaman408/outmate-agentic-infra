curl --request GET \
  --url https://app.bettercontact.rocks/api/v2/account \
  --header 'X-API-Key: <api-key>'

import requests

url = "https://app.bettercontact.rocks/api/v2/account"

headers = {"X-API-Key": "<api-key>"}

response = requests.get(url, headers=headers)

print(response.text)

{
  "success": true,
  "credits_left": 32377,
  "email": "your_email@mycompany.com"
}

import requests

url = "https://app.bettercontact.rocks/api/v2/lead_finder/async"

payload = {
    "filters": {
        "company": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "company_industry": {
            "include": ["it services and it consulting"],
            "exclude": ["it services and it consulting"]
        },
        "company_technology": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "company_headcount_min": 5000000,
        "company_headcount_max": 5000000,
        "lead_fullname": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "lead_linkedin_url": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "lead_department": {
            "include": ["operations"],
            "exclude": ["operations"]
        },
        "lead_function": {
            "include": ["operations"],
            "exclude": ["operations"]
        },
        "lead_skills": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "lead_job_title": {
            "include": ["<string>"],
            "exclude": ["<string>"],
            "exact_match": True
        },
        "lead_location": {
            "include": ["<string>"],
            "exclude": ["<string>"]
        },
        "lead_seniority": {
            "include": ["senior"],
            "exclude": ["senior"]
        }
    },
    "max_leads": 100,
    "webhook": "<string>"
}
headers = {
    "X-API-Key": "<api-key>",
    "Content-Type": "application/json"
}

response = requests.post(url, json=payload, headers=headers)

print(response.text)

{
  "success": true,
  "message": "Lead finder request accepted.",
  "request_id": "bc39ffbfc24cf043b748"
}

