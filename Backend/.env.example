################################################################################
# Outmate Backend Configuration
# This is an example configuration file. Copy to .env and fill in actual values.
#
# IMPORTANT: Never commit .env with real credentials to version control.
# Add .env to .gitignore (already done in this project).
################################################################################

# ============================================================================
# DATABASE CONFIGURATION (Supabase with Session Pooler)
# ============================================================================
# Session Pooler provides connection pooling for PostgreSQL.
# This prevents exhausting connection limits on managed databases.
#
# Format: postgresql+psycopg2://[user].[project-ref]:[password]@[host]:5432/[database]
#
# To find your details:
# 1. Go to https://app.supabase.com
# 2. Select your project (Outmate)
# 3. Settings > Database > Connection Pooling > Session Mode
# 4. Copy the connection string and add your password
#
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# ============================================================================
# REDIS CONFIGURATION (Upstash with TLS)
# ============================================================================
# Upstash Redis provides managed Redis with TLS encryption.
# Must use rediss:// protocol (note the double 's') for TLS.
#
# To set up:
# 1. Go to https://console.upstash.com
# 2. Create or select your Redis database
# 3. Copy the connection string (UPSTASH_REDIS_REST_URL)
# 4. Convert to TCP URL: rediss://default:[password]@[host]:6379
#
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379

# ============================================================================
# API KEYS & INTEGRATIONS
# ============================================================================

# CrustData API
CRUSTDATA_API_KEY=your_crustdata_key_here

# Explorium API
EXPLORIUM_API_KEY=your_explorium_key_here
EXPLORIUM_BASE_URL=https://api.explorium.ai/v1

# ContactOut API
CONTACTOUT_API_KEY=your_contactout_key_here
CONTACTOUT_TIMEOUT=30

# IP Info (for visitor geo-location)
IPINFO_TOKEN=your_ipinfo_token_here

# Enrich API (for prospect data enrichment)
ENRICH_API_KEY=your_enrich_key_here

# OpenRouter (Claude access via API proxy)
OPENROUTER_API_KEY=your_openrouter_key_here

# Perplexity API
PERPLEXITY_API_KEY=your_perplexity_key_here

# Tavily API (search/research)
TAVILY_API_KEY=your_tavily_key_here

# Serper API (Google search results)
SERPER_API_KEY=your_serper_key_here

# SEC API
SEC_API_KEY=your_sec_key_here

# Gemini API
GEMINI_API_KEY=your_gemini_key_here

# BrightData API
BRIGHTDATA_API_TOKEN=your_brightdata_token_here

# Contextual AI
CONTEXTUAL_AI_API_KEY=your_contextual_ai_key_here

# ============================================================================
# AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_64_CHAR_CRYPTOGRAPHICALLY_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ============================================================================
# OPENAI-COMPATIBLE ROUTING (via OpenRouter)
# ============================================================================
OPENAI_API_KEY=your_openrouter_key_here    # can reuse OPENROUTER_API_KEY value
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ============================================================================
# GOOGLE OAUTH (Gmail integration)
# ============================================================================
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/campaigns/gmail/callback

# ============================================================================
# UNIPILE (LinkedIn / email outreach)
# ============================================================================
UNIPILE_API_KEY=your_unipile_api_key_here
UNIPILE_DSN=https://apiXX.unipile.com:XXXXX

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# App metadata
APP_NAME=Outmate AI - Backend API
APP_VERSION=1.0.0
APP_WEBHOOK_URL=http://localhost:3000

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Visitor tracking deduplication (in seconds, 0 to disable)
VISITOR_DEDUPE_SECONDS=3600

# Employee Discovery (optional — all graceful fallback if absent)
APOLLO_API_KEY=
PDL_API_KEY=
HUNTER_API_KEY=
CLEARBIT_API_KEY=
APIFY_API_KEY=

# ============================================================================
# NOTES FOR AZURE DEPLOYMENT
# ============================================================================
#
# 1. Set ENVIRONMENT=production when deploying
# 2. Use Azure Key Vault or App Configuration for secrets
# 3. Set all environment variables via Azure App Service > Configuration
# 4. Do NOT commit .env to version control
# 5. Use strong, random values for JWT_SECRET
# 6. Test database and Redis connectivity after deployment:
#    curl https://your-app.azurewebsites.net/health
# 7. Monitor logs in Azure Log Analytics
#
################################################################################
