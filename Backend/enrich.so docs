# LeadCountResponse

## OpenAPI Specification

```yaml
openapi: 3.0.1
info:
  title: ''
  description: ''
  version: 1.0.0
paths: {}
components:
  schemas:
    LeadCountResponse:
      type: object
      required:
        - success
        - data
      properties:
        success:
          type: boolean
          const: true
        data:
          type: object
          required:
            - count
            - searchType
            - isApproximate
          properties:
            count:
              type: integer
              description: >-
                Maximum pageable results. For <=10k: exact deduped count. For
                >10k: approximate count with 25% dedup discount. Capped at
                500,000 to prevent excessive pagination. Equals
                searchedTotalResult when under 500k.
            searchType:
              type: string
              enum:
                - people
                - company
                - unified
              description: Type of search performed
            isApproximate:
              type: boolean
              description: >-
                True when results exceed 10,000 — count is estimated with a 25%
                dedup discount instead of running an exact dedup query
            searchedTotalResult:
              type: integer
              description: >-
                Total leads matching your search. Same as count when under 500k.
                When count hits the 500k pagination cap, this field shows the
                raw total count without any discount or cap applied.
          x-apidog-orders:
            - count
            - searchType
            - isApproximate
            - searchedTotalResult
        meta:
          type: object
          properties:
            requestId:
              type: string
          x-apidog-orders:
            - requestId
      x-apidog-orders:
        - success
        - data
        - meta
      x-apidog-folder: ''
  securitySchemes: {}
servers:
  - url: https://dev.enrich.so/api/v3
    description: Production
security: []

