          type: integer
          description: Total navigable pages based on totalResults (capped at 500,000)
        hasMore:
          type: boolean
          description: Whether more pages exist beyond the current page
        isApproximate:
          type: boolean
          description: >-
            True when results exceed 10,000 — count is estimated with a 25%
            dedup discount instead of running an exact dedup query
        searchedTotalResult:
          type: integer
          description: >-
            Total leads matching your search. Same as totalResults when under
            500k. When totalResults hits the 500k pagination cap, this field
            shows the raw total count without any discount or cap applied.
