# Outmate.ai Production Environment Variables

# Copy this file to create your .env.production file
# Fill in actual values (do not commit real secrets)

# ============================================================================
# APPLICATION ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=WARNING
DEBUG=false

# ============================================================================
# DATABASE CONFIGURATION (Supabase)
# ============================================================================
DATABASE_URL=postgresql+psycopg2://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_REGION.pooler.supabase.com:5432/postgres

# ============================================================================
# REDIS CONFIGURATION (Upstash)
# ============================================================================
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST.upstash.io:6379

# ============================================================================
# AUTHENTICATION
# ============================================================================
JWT_SECRET=YOUR_64_CHARACTER_RANDOM_STRING
JWT_EXPIRES_IN=24h

# ============================================================================
# API KEYS & INTEGRATIONS
# ============================================================================
CRUSTDATA_API_KEY=YOUR_CRUSTDATA_API_KEY
EXPLORIUM_API_KEY=YOUR_EXPLORIUM_API_KEY
EXPLORIUM_BASE_URL=https://api.explorium.ai/v1
CONTACTOUT_API_KEY=YOUR_CONTACTOUT_API_KEY
CONTACTOUT_TIMEOUT=30
IPINFO_TOKEN=YOUR_IPINFO_TOKEN
ENRICH_API_KEY=YOUR_ENRICH_API_KEY
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_AUTH_URL=
SALESFORCE_TOKEN_URL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_AUTH_URL=
DYNAMICS_TOKEN_URL=
DYNAMICS_SCOPE=
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY
TAVILY_API_KEY=YOUR_TAVILY_API_KEY
SERPER_API_KEY=YOUR_SERPER_API_KEY
SEC_API_KEY=YOUR_SEC_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
BRIGHTDATA_API_TOKEN=YOUR_BRIGHTDATA_TOKEN
CONTEXTUAL_AI_API_KEY=YOUR_CONTEXTUAL_AI_KEY

# ============================================================================
# OPENAI-COMPATIBLE ROUTING
# ============================================================================
OPENAI_API_KEY=YOUR_OPENROUTER_API_KEY
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ============================================================================
# GOOGLE OAUTH
# ============================================================================
GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://api.outmate.ai/api/v1/auth/google/callback

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ALLOWED_ORIGINS=https://app.outmate.ai,https://outmate.ai,https://dev.outmate.ai

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_AUTH=10
RATE_LIMIT_SEARCH=30
