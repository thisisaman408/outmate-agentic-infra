# Description: Example of .env file
# Usage: Copy this file to .env and change the values
#        according to your needs
#        Do not commit .env file to git
#        Do not change .env.example file

# Config directory
# Directory where files, logs and database will be stored
# Example: outmate_CONFIG_DIR=~/.outmate
outmate_CONFIG_DIR=

# Save database in the config directory
# Values: true, false
# If false, the database will be saved in outmate's root directory
# This means that the database will be deleted when outmate is uninstalled
# and that the database will not be shared between different virtual environments
# Example: outmate_SAVE_DB_IN_CONFIG_DIR=true
outmate_SAVE_DB_IN_CONFIG_DIR=

# Database URL
# Postgres example: outmate_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outmate
# SQLite example:
outmate_DATABASE_URL=sqlite:///./outmate.db

# Alembic logs path flag. If set to true, Alembic will log to stdout.
outmate_ALEMBIC_LOG_TO_STDOUT=False


# mem0 creates a directory 
# for chat history, vector stores, and other artifacts
# its default path is ~/.mem0.
# we can change this path with 
# environment variable "MEM0_DIR"
# Example: MEM0_DIR=/tmp/.mem0

# composio creates a cache directory 
# for file uploads/downloads.
# its default path is ~/.composio
# we can change this path with 
# environment variable "COMPOSIO_CACHE_DIR"
# Example: COMPOSIO_CACHE_DIR=/tmp/.composio


# Database connection retry
# Values: true, false
# If true, the database will retry to connect to the database if it fails
# Example: outmate_DATABASE_CONNECTION_RETRY=true
outmate_DATABASE_CONNECTION_RETRY=false

# Cache type
outmate_LANGCHAIN_CACHE=SQLiteCache

# Server host
# Example: outmate_HOST=localhost
outmate_HOST=

# Worker processes
# Example: outmate_WORKERS=1
outmate_WORKERS=

# Server port
# Example: outmate_PORT=7860
outmate_PORT=

# Logging level
# Example: outmate_LOG_LEVEL=critical
outmate_LOG_LEVEL=

# Path to the log file
# Example: outmate_LOG_FILE=logs/outmate.log
outmate_LOG_FILE=

# Time/Size for log to rotate
# Example: outmate_LOG_ROTATION=‘10 MB’/‘1 day’
outmate_LOG_ROTATION=

# Path to the frontend directory containing build files
# Example: outmate_FRONTEND_PATH=/path/to/frontend/build/files
outmate_FRONTEND_PATH=

# Whether to open the browser after starting the server
# Values: true, false
# Example: outmate_OPEN_BROWSER=true
outmate_OPEN_BROWSER=

# Whether to remove API keys from the projects saved in the database
# Values: true, false
# Example: outmate_REMOVE_API_KEYS=false
outmate_REMOVE_API_KEYS=

# Whether to use RedisCache or ThreadingInMemoryCache or AsyncInMemoryCache
# Values: async, memory, redis
# Example: outmate_CACHE_TYPE=memory
# If you want to use redis then the following environment variables must be set:
# outmate_REDIS_HOST (default: localhost)
# outmate_REDIS_PORT (default: 6379)
# outmate_REDIS_DB (default: 0)
# outmate_REDIS_CACHE_EXPIRE (default: 3600)
outmate_CACHE_TYPE=

# Set outmate_AUTO_LOGIN to false if you want to disable auto login
# and use the login form to login. outmate_SUPERUSER and outmate_SUPERUSER_PASSWORD
# must be set if AUTO_LOGIN is set to false
# Values: true, false
outmate_AUTO_LOGIN=

# SET outmate_ENABLE_SUPERUSER_CLI to false to disable
# superuser creation via the CLI
outmate_ENABLE_SUPERUSER_CLI=

# Superuser username
# Example: outmate_SUPERUSER=admin
outmate_SUPERUSER=

# Superuser password
# Example: outmate_SUPERUSER_PASSWORD=123456
outmate_SUPERUSER_PASSWORD=

# API Key Source
# Controls how API keys are validated for the x-api-key header
# Values: db, env
# - db (default): Validates against API keys stored in the database
# - env: Validates against the outmate_API_KEY environment variable
# Example: outmate_API_KEY_SOURCE=db
outmate_API_KEY_SOURCE=

# API Key (only used when outmate_API_KEY_SOURCE=env)
# The API key to use for authentication when API_KEY_SOURCE is set to 'env'
# This allows injecting a pre-defined API key via environment variables
# (useful for Kubernetes Secrets, CI/CD pipelines, etc.)
# Example: outmate_API_KEY=your-secure-api-key
outmate_API_KEY=

# Should store environment variables in the database
# Values: true, false
outmate_STORE_ENVIRONMENT_VARIABLES=

# Should enable the MCP composer feature in MCP projects
# Values: true, false
# Default: true
outmate_MCP_COMPOSER_ENABLED=

# STORE_URL
# Example: outmate_STORE_URL=https://api.outmate.store
# outmate_STORE_URL=

# DOWNLOAD_WEBHOOK_URL
#
# outmate_DOWNLOAD_WEBHOOK_URL=

# LIKE_WEBHOOK_URL
#
# outmate_LIKE_WEBHOOK_URL=

# Value must finish with slash /
#BACKEND_URL=http://localhost:7860/
BACKEND_URL=
